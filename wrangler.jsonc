{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rimbakawal",
  "main": "./worker/offline.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rimbakawal-db",
      "database_id": "8529e0e9-faf7-4953-8fbd-aefb539df73b",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
