{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rimbakawal",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
